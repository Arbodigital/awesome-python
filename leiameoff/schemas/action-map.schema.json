{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Leiameoff Action Map",
  "type": "object",
  "required": ["product", "topic", "actions"],
  "properties": {
    "product": { "type": "string" },
    "topic": { "type": "string" },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "steps", "evidence_level", "sources"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } },
          "evidence_level": {
            "type": "string",
            "enum": ["official", "community_validated", "experimental"]
          },
          "sources": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "risks": { "type": "array", "items": { "type": "string" } },
          "prerequisites": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
